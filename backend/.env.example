# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_platform

# ---- Square ----
# Get a sandbox access token from https://developer.squareup.com/apps
# (Dashboard -> your app -> Sandbox -> Sandbox Access Token).
# Providing this token lets the local demo skip the full OAuth redirect flow.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
# Optional: pins a specific sandbox location instead of auto-picking the first one Square
# returns. Only needed if your sandbox account has more than one location.
SQUARE_LOCATION_ID=
# "Application ID" in the Square dashboard. Only needed for the full OAuth flow below, not
# for the sandbox-token path above.
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_REDIRECT_URI=http://localhost:4000/api/pos/square/oauth/callback
# Signature key from Square Dashboard -> Webhooks -> your subscription.
# Required to verify POST /api/webhooks/square in real mode.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match exactly the URL you registered with Square for webhook signature verification.
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:4000/api/webhooks/square

# ---- Toast ----
# Leave blank for MOCK mode (default). With real credentials, set TOAST_MODE=live plus these three.
TOAST_MODE=mock
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
TOAST_WEBHOOK_SECRET=
